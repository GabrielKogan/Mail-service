{
  "name": "mail-service-lujan",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:worker": "esbuild worker/index.ts --platform=node --target=node20 --format=cjs --outfile=dist/worker.js --tsconfig=tsconfig.json",
    "worker": "node dist/worker.js",
    "worker:dev": "esbuild worker/index.ts --platform=node --target=node20 --format=cjs --outfile=dist/worker.js --tsconfig=tsconfig.json && node --env-file=.env dist/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1139.0",
    "@aws-sdk/client-sqs": "^3.1139.0",
    "@prisma/client": "^5.22.0",
    "next": "^16.3.6",
    "nodemailer": "^10.0.10",
    "postcss": "8.5.23",
    "prisma": "^5.22.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "recharts": "^3.10.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "form-data": "2.5.6",
    "postcss": "8.5.23",
    "uuid": "11.1.1",
    "tough-cookie": "4.1.3",
    "qs": "6.14.1"
  }
}

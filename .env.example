# Copiar este archivo a .env y completar con los valores reales.
# .env nunca se sube al repositorio (ver .gitignore).

DATABASE_URL="sqlserver://TU_SERVIDOR:1433;database=TU_BASE;user=TU_USUARIO;password=TU_PASSWORD;encrypt=true;trustServerCertificate=true"
BREVO_API_KEY="tu_api_key_de_brevo"

# Token compartido para autenticar llamadas internas al endpoint /api/mail
INTERNAL_API_TOKEN="generar_un_token_largo_y_random"

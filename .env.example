# Copiar este archivo a .env y completar con los valores reales.
# .env nunca se sube al repositorio (ver .gitignore).
# En Docker se usan dos archivos: .env.web (contenedor web) y .env.worker (worker),
# cada uno con las credenciales IAM de su usuario (mail-api / mail-worker). Permisos 600.
# En producción la app no arranca si la configuración es inválida (lib/config.ts).

DATABASE_URL="sqlserver://HOST:1433;database=MAIL_QUEUE_TEST;user=USER;password=PASSWORD;encrypt=true;trustServerCertificate=true"
# Solo desarrollo (prisma migrate dev): base auxiliar vacía, p. ej. MAIL_QUEUE_SHADOW.
SHADOW_DATABASE_URL="sqlserver://HOST:1433;database=MAIL_QUEUE_SHADOW;user=USER;password=PASSWORD;encrypt=true;trustServerCertificate=true"

# ---------- Envío ----------
# Motor: "ses" (SES por SMTP, default), "ses-api" (SES por API v2, recomendado con el worker),
# "brevo" o "smtp".
MAIL_PROVIDER=ses
MAIL_FROM_EMAIL="registro@lujandecuyo.gob.ar"
MAIL_FROM_NAME="Municipalidad de Lujan de Cuyo"
AWS_REGION=eu-central-1

# Amazon SES (SMTP). Crear en SES → SMTP settings → Create SMTP credentials.
# SMTP_USER = SMTP Username (Access Key ID, empieza con AKIA), NO el nombre
# ses-smtp-user.... SMTP_PASS = SMTP password de esa misma pantalla.
SMTP_USER=
SMTP_PASS=
# Opcionales en modo ses (si faltan: host email-smtp.{AWS_REGION}.amazonaws.com y puerto 587)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false

# Requerido si MAIL_PROVIDER=brevo
# BREVO_API_KEY="tu_api_key_de_brevo"

# Requerido si MAIL_PROVIDER=smtp (host completo, ej. smtp.envialosimple.email)
# SMTP_HOST=smtp.envialosimple.email

# Credenciales IAM para SQS y ses-api (web: mail-api; worker: mail-worker).
# `web` las necesita también con MAIL_PROVIDER=ses (SMTP): al reactivar un rebote o una
# queja quita la dirección de la lista de supresión de SES, y /sistemas muestra el estado
# de DKIM, MAIL FROM y la cuenta. Sin credenciales, eso aparece como "no se pudo consultar".
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Envíos por segundo por proceso, un poco por debajo del límite de la cuenta de SES.
SES_MAX_SEND_RATE=10

# ---------- Secretos (en producción: obligatorios, 32+ caracteres y distintos entre sí) ----------
# Generar con: openssl rand -hex 32
# Token del panel (/login) y de /api/admin/*.
ADMIN_TOKEN="mail_service_token_1234567890"
# Firma el píxel de apertura y los links de baja.
UNSUBSCRIBE_HMAC_SECRET=
# Secreto anterior, solo durante la transición (links viejos). Al migrar: el valor que
# firmaba hasta ahora (TRACKING_SECRET si estaba definido; si no, INTERNAL_API_TOKEN).
# UNSUBSCRIBE_HMAC_SECRET_PREVIOUS=

# Token compartido viejo. Solo mientras haya sistemas sin clave propia (x-api-key).
INTERNAL_API_TOKEN="mail_service_token_1234567890"
LEGACY_TOKEN_ENABLED=true
# true = el panel también acepta INTERNAL_API_TOKEN (solo transición).
DASHBOARD_LEGACY_TOKEN=false

# ---------- Tracking y bajas ----------
# URL pública de esta app (sin barra final). Necesaria para que Gmail/etc. reporten apertura
# y para el link de baja. En local con ngrok: APP_BASE_URL=https://xxxx.ngrok-free.app
APP_BASE_URL=

# Solo para orígenes SIN sistema registrado en /sistemas: los de esta lista son
# transaccionales (sin link de baja). Si la variable no existe: turnos,expediente.
MAIL_ORIGENES_CRITICOS=turnos,expediente

# ---------- Eventos de SES ----------
# Configuration set (eventos → SNS → cola mail-events y/o webhook).
# SES_CONFIGURATION_SET=mail-service-events
# El webhook y el worker solo aceptan mensajes de este tópico.
# SES_SNS_TOPIC_ARN=arn:aws:sns:eu-central-1:123456789012:mail-service-events
# false = /api/webhooks/ses responde 410 (cuando los eventos ya llegan por la cola).
SES_WEBHOOK_ENABLED=true

# ---------- Colas SQS (ver docs/aws-setup.md) ----------
# sync = envía en el momento (200/502). queue = encola y responde 202 (requiere el worker).
MAIL_SEND_MODE=sync
# SQS_SEND_QUEUE_URL=https://sqs.eu-central-1.amazonaws.com/123456789012/mail-send
# SQS_SEND_DLQ_URL=https://sqs.eu-central-1.amazonaws.com/123456789012/mail-send-dlq
# SQS_EVENTS_QUEUE_URL=https://sqs.eu-central-1.amazonaws.com/123456789012/mail-events
# Worker: mensajes en paralelo por cola y nombre en el latido (default: hostname).
WORKER_CONCURRENCY=5
# WORKER_NAME=worker-1

# ---------- Google Postmaster Tools (dashboard + alertas) ----------
# Cliente OAuth (tipo Web) y clave de 32+ caracteres para cifrar el refresh token.
# Ir en .env.web y .env.worker. Guía: docs/google-postmaster.md
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_TOKEN_KEY=
# Mail que recibe alertas (spam ≥ 0,3 %, reputación LOW/BAD, DKIM/DMARC < 95 %, token vencido).
# ALERTAS_EMAIL=sistemas@lujandecuyo.gob.ar

# Orígenes del navegador (coma) permitidos para todos. Además, cada sistema tiene los suyos
# en /sistemas. Vacío = solo servidor a servidor. * = todos (solo pruebas).
# CORS_ORIGINS=https://turnos.lujandecuyo.gob.ar
CORS_ORIGINS=
